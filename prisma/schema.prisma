generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Attestation {
  id             String   @id @default(cuid())
  fullName       String
  passport       String   @unique
  passportCountry String
  profession     String
  visitDate      DateTime?
  conviction     String
  rfBan          String
  attestations    Json?
  photoUrls      String[]
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  certificateNumber Int      @default(autoincrement())
}

